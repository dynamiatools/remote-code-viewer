{
  "name": "@dynamia-tools/remote-code-viewer",
  "version": "0.1.0",
  "description": "Ultra-light, mobile-first, read-only viewer for a remote codebase",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.10"
  },
  "bin": {
    "remote-code-viewer": "bin/remote-code-viewer.mjs"
  },
  "files": [
    "bin",
    "src/server",
    "dist/web"
  ],
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.0.0",
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0",
    "vue": "^3.5.0"
  },
  "scripts": {
    "dev": "concurrently -k \"node bin/remote-code-viewer.mjs --verbose\" \"vite --config src/web/vite.config.mjs\"",
    "build": "vite build --config src/web/vite.config.mjs",
    "start": "node bin/remote-code-viewer.mjs",
    "test": "node --test test/*.test.mjs",
    "test:watch": "node --test --watch test/*.test.mjs",
    "prepublishOnly": "npm run build"
  }
}
